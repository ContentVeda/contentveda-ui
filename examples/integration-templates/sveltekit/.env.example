# ContentVeda public API — generated for page "__CV_PAGE_TITLE__" (/__CV_SLUG__)
CV_API_URL=__CV_API_URL__
CV_GRAPHQL_URL=__CV_GRAPHQL_URL__
# Workspace slug (sent as X-Tenant-Key)
CV_TENANT_KEY=__CV_TENANT_KEY__
# API key for the "__CV_ENVIRONMENT__" environment (ContentVeda → Settings → API Keys). Server-side only.
CV_API_KEY=
# desktop | mweb | app — leave empty for the universal page (same for every platform)
CV_PLATFORM=__CV_PLATFORM__
# rest | graphql
CV_API_MODE=__CV_API_MODE__
# Page rendered at "/" (every other slug is served at /<slug>)
CV_PAGE_SLUG=__CV_SLUG__
# Resolve relations between custom content entries (REST and GraphQL): '*' = one level,
# 'brand.owner,categories' = named paths, empty = leave them as entry ids
CV_POPULATE=*
# Base URL for media file ids in banners
PUBLIC_CV_MEDIA_URL=__CV_MEDIA_URL__
