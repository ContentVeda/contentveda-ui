{
  "name": "@contentveda/ui",
  "version": "0.2.6",
  "description": "A universal, framework-agnostic UI component library built with Mitosis. Write once, compile to React, Svelte, and Web Components.",
  "author": "Koushik Manna",
  "license": "MIT",
  "homepage": "https://docs.contentveda.com/ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContentVeda/contentveda-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ContentVeda/contentveda-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ui",
    "components",
    "mitosis",
    "react",
    "svelte",
    "web-components",
    "banner",
    "slider",
    "cms",
    "headless"
  ],
  "files": [
    "dist/",
    "src/styles/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/react/src/components/index.js",
    "./theme.css": "./dist/styles/theme.css",
    "./styles/*": "./dist/styles/*",
    "./react/*": "./dist/react/src/components/*.js",
    "./react/utils/*": "./dist/react/src/utils/*.js",
    "./svelte/*": "./dist/svelte/src/components/*",
    "./svelte/utils/*": "./dist/svelte/src/utils/*",
    "./webcomponent/*": "./dist/webcomponent/dist/*",
    "./webcomponent/utils/*": "./dist/webcomponent/dist/utils/*.js",
    "./vue/*": "./dist/vue/src/components/*.vue",
    "./solid/*": "./dist/solid/src/components/*.jsx",
    "./angular/*": "./dist/angular/src/components/*"
  },
  "main": "./dist/react/src/components/index.js",
  "scripts": {
    "build": "npx mitosis build && node fix-styles.js && node fix-props.js && node fix-framework-utils.js && node fix-angular.js && node fix-react.js && node fix-wc-props.js && node build-wc.js && node fix-wc-onmount.js && node fix-minify.js",
    "docs": "node scripts/generate-docs.js",
    "postbuild": "npm run docs",
    "prepare": "husky && npm run build",
    "prepublishOnly": "npm run build",
    "postpublish": "node -e \"if (process.env.CI !== 'true' && process.env.GITHUB_ACTIONS !== 'true') require('./scripts/sync-beta-tag.js')\"",
    "release": "semantic-release",
    "test": "npm run test:unit && npm run test:bdd && npm run test:e2e",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "test:bdd": "playwright install chromium && cucumber-js --config cucumber.cjs",
    "report:allure": "node scripts/generate-allure-report.js",
    "serve:docs": "node scripts/serve-docs.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:bdd && npm run test:e2e"
  },
  "peerDependencies": {
    "@angular/core": ">=14",
    "react": ">=17",
    "react-dom": ">=17",
    "solid-js": "^1.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "overrides": {
    "nanoid": "3.3.18",
    "cookie": "0.7.0"
  },
  "devDependencies": {
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.3.0",
    "@angular/core": "^14.3.0",
    "@angular/platform-browser": "^14.3.0",
    "@angular/platform-browser-dynamic": "^14.3.0",
    "@axe-core/playwright": "^4.12.1",
    "@builder.io/mitosis": "^0.14.0",
    "@builder.io/mitosis-cli": "^0.14.0",
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.42",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "core-js": "^3.50.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-solid": "^0.6.0",
    "esbuild-plugin-vue3": "^0.5.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "zone.js": "^0.12.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "isomorphic-dompurify": "^4.2.0"
  }
}
